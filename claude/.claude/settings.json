{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "ArtifactComments",
      "Bash(tmux send-keys*)",
      "mcp__claude_ai_Claude_Docs__batch",
      "mcp__claude_ai_Claude_Docs__create",
      "mcp__claude_ai_Claude_Docs__guide",
      "mcp__claude_ai_Claude_Docs__query",
      "mcp__claude_ai_Claude_Docs__read",
      "mcp__claude_ai_Claude_Docs__update"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/scripts/claude-task-done-notify.sh"
          },
          {
            "type": "command",
            "command": "~/.local/scripts/claude-save-response.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if command -v rtk >/dev/null 2>&1; then rtk hook claude; fi"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); model=$(echo \"$input\" | jq -r '.model.display_name'); folder=$(basename \"$(pwd)\"); used=$(echo \"$input\" | jq -r '.context_window.used_percentage // \"N/A\"'); total_in=$(echo \"$input\" | jq -r '.context_window.total_input_tokens // 0'); total_out=$(echo \"$input\" | jq -r '.context_window.total_output_tokens // 0'); ctx_size=$(echo \"$input\" | jq -r '.context_window.context_window_size // 1'); session_pct=$(awk \"BEGIN {printf \\\"%.1f\\\", (($total_in + $total_out) / $ctx_size) * 100}\"); echo \"$model | $folder | Context: $used% used | Session: $session_pct% used\""
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": false,
    "lua-lsp@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "product-dev-skills@product-dev-skills": true,
    "polkadot-skills@product-skills": true,
    "caveman@caveman": true,
    "eli5@claude-community": true
  },
  "extraKnownMarketplaces": {
    "karpathy-skills": {
      "source": {
        "source": "github",
        "repo": "forrestchang/andrej-karpathy-skills"
      }
    },
    "product-dev-skills": {
      "source": {
        "source": "github",
        "repo": "pgherveou/product-dev-skills"
      }
    },
    "product-skills": {
      "source": {
        "source": "github",
        "repo": "paritytech/product-skills"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "claude-community": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-community"
      }
    }
  },
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "xhigh"
    }
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "editorMode": "vim",
  "skipAutoPermissionPrompt": true
}
